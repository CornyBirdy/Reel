# Batch files must keep Windows (CRLF) line endings or cmd.exe can misparse them,
# including when the repo is downloaded as a ZIP or cloned on another OS.
*.bat text eol=crlf
*.cmd text eol=crlf

# Everything else: normalise to LF in the repo.
* text=auto
*.png binary
*.ico binary

# GitHub's "Download ZIP" runs `git archive`, which expands this to "<commit sha> <date>",
# so a ZIP install knows exactly which version it is and the updater can compare it.
reel/VERSION export-subst
