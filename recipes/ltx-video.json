{
  "schema": 1,
  "id": "ltx-video",
  "name": "LTX-Video",
  "family": "Lightricks",
  "version": "0.9.5 (2B)",
  "status": "ready",
  "kind": "video",
  "verified": true,
  "summary": "Fast DiT video model. 2B transformer with an 8-bit T5 text encoder: small download, quick iterations, comfortable on 16 GB.",
  "license": "LTX-Video Open Weights License",
  "license_url": "https://huggingface.co/Lightricks/LTX-Video/blob/main/ltx-video-2b-v0.9.5.license.txt",
  "tasks": [
    "text-to-video"
  ],
  "adapter": "ltx_video",
  "adapter_config": {
    "pipeline": "LTXPipeline",
    "text_encoder_dir": "text_encoder_8bit"
  },
  "download_gb": 12.2,
  "vram_gb": 10,
  "vram_note": "Estimate from upstream guidance, not measured on a 5070 Ti. Reel shows the real peak per clip in History.",
  "python": {
    "torch_index": "https://download.pytorch.org/whl/cu128",
    "torch": [
      "torch>=2.7",
      "torchvision"
    ],
    "packages": [
      "diffusers>=0.33",
      "transformers>=4.49",
      "accelerate>=1.4",
      "bitsandbytes>=0.46",
      "sentencepiece",
      "protobuf",
      "safetensors",
      "huggingface_hub",
      "imageio",
      "imageio-ffmpeg",
      "numpy",
      "Pillow"
    ]
  },
  "weights": [
    {
      "repo_id": "Lightricks/LTX-Video-0.9.5",
      "dest": ".",
      "allow_patterns": [
        "model_index.json",
        "scheduler/*",
        "tokenizer/*",
        "transformer/*",
        "vae/*"
      ]
    },
    {
      "repo_id": "Lightricks/T5-XXL-8bit",
      "dest": "text_encoder_8bit",
      "allow_patterns": [
        "*.json",
        "*.safetensors"
      ]
    }
  ],
  "limits": {
    "max_width": 1216,
    "max_height": 704,
    "size_multiple": 32,
    "frames": {
      "step": 8,
      "offset": 1,
      "min": 9,
      "max": 161,
      "default": 97
    },
    "fps": 24,
    "steps": {
      "min": 1,
      "max": 100
    },
    "presets": [
      {
        "w": 512,
        "h": 320
      },
      {
        "w": 640,
        "h": 384
      },
      {
        "w": 704,
        "h": 480
      },
      {
        "w": 768,
        "h": 512
      },
      {
        "w": 960,
        "h": 544
      },
      {
        "w": 1216,
        "h": 704
      }
    ]
  },
  "native": {
    "label": "1216×704",
    "resolutions": [
      {
        "w": 1216,
        "h": 704,
        "label": "1216×704 (model card headline size)"
      },
      {
        "w": 768,
        "h": 512,
        "label": "768×512 (diffusers example)"
      },
      {
        "w": 704,
        "h": 512,
        "label": "704×512 (pipeline default)"
      }
    ],
    "frames": [
      161,
      257
    ],
    "fps": 24,
    "source": "https://huggingface.co/Lightricks/LTX-Video-0.9.5 and https://huggingface.co/docs/diffusers/api/pipelines/ltx_video",
    "note": "Width and height must be divisible by 32 and frames must be 8n+1. The card says the model works best under 720×1280 and below 257 frames. Its intro mentions 30 FPS videos at 1216×704, while the diffusers examples export at 24 fps; Reel uses 24."
  },
  "unlock": {
    "max_width": 1280,
    "max_height": 1280,
    "max_frames": 257,
    "known": true,
    "note": "The card: works best on resolutions under 720×1280 and frame counts below 257. Not a hard limit."
  },
  "defaults": {
    "width": 704,
    "height": 480,
    "steps": 40,
    "guidance": 3.0,
    "negative_prompt": "worst quality, inconsistent motion, blurry, jittery, distorted",
    "offload": "model",
    "vae_tiling": true,
    "quantization": "none"
  },
  "memory": {
    "offload_options": [
      "none",
      "model",
      "sequential"
    ],
    "quantization_options": [
      "none",
      "int8",
      "nf4"
    ],
    "notes": "The text encoder is stored as 8-bit weights. Quantization here applies to the 2B transformer, which is only ~4 GB in bf16, so it defaults to off.",
    "estimate": {
      "weights_gb": {
        "transformer": 3.9,
        "text_encoder": 5.9,
        "vae": 1.3
      },
      "quantized": [
        "transformer"
      ],
      "transient": [
        "text_encoder"
      ],
      "denoiser": "transformer",
      "tokens": {
        "spatial": 32,
        "temporal": 8
      },
      "hidden": 2048,
      "vae_mb_per_mpx_frame": 768,
      "vae_tile_mpx_frames": 1.5
    }
  }
}
