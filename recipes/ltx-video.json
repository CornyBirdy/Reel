{
  "schema": 1,
  "id": "ltx-video",
  "name": "LTX-Video",
  "family": "Lightricks",
  "version": "0.9.5 (2B)",
  "status": "ready",
  "summary": "Fast DiT video model. 2B transformer with an 8-bit T5 text encoder: small download, quick iterations, comfortable on 16 GB.",
  "license": "LTX-Video Open Weights License",
  "license_url": "https://huggingface.co/Lightricks/LTX-Video/blob/main/ltx-video-2b-v0.9.5.license.txt",
  "tasks": [
    "text-to-video"
  ],
  "adapter": "ltx_video",
  "adapter_config": {
    "pipeline": "LTXPipeline",
    "text_encoder_dir": "text_encoder_8bit"
  },
  "download_gb": 12.2,
  "vram_gb": 10,
  "vram_note": "Estimate from upstream guidance, not measured on a 5070 Ti. Reel shows the real peak per clip in History.",
  "python": {
    "torch_index": "https://download.pytorch.org/whl/cu128",
    "torch": [
      "torch>=2.7",
      "torchvision"
    ],
    "packages": [
      "diffusers>=0.33",
      "transformers>=4.49",
      "accelerate>=1.4",
      "bitsandbytes>=0.46",
      "sentencepiece",
      "protobuf",
      "safetensors",
      "huggingface_hub",
      "imageio",
      "imageio-ffmpeg",
      "numpy",
      "Pillow"
    ]
  },
  "weights": [
    {
      "repo_id": "Lightricks/LTX-Video-0.9.5",
      "dest": ".",
      "allow_patterns": [
        "model_index.json",
        "scheduler/*",
        "tokenizer/*",
        "transformer/*",
        "vae/*"
      ]
    },
    {
      "repo_id": "Lightricks/T5-XXL-8bit",
      "dest": "text_encoder_8bit",
      "allow_patterns": [
        "*.json",
        "*.safetensors"
      ]
    }
  ],
  "limits": {
    "max_width": 1216,
    "max_height": 704,
    "size_multiple": 32,
    "frames": {
      "step": 8,
      "offset": 1,
      "min": 9,
      "max": 161,
      "default": 97
    },
    "fps": 24,
    "steps": {
      "min": 1,
      "max": 100
    },
    "presets": [
      {
        "w": 512,
        "h": 320
      },
      {
        "w": 640,
        "h": 384
      },
      {
        "w": 704,
        "h": 480
      },
      {
        "w": 768,
        "h": 512
      },
      {
        "w": 960,
        "h": 544
      },
      {
        "w": 1216,
        "h": 704
      }
    ]
  },
  "defaults": {
    "width": 704,
    "height": 480,
    "steps": 40,
    "guidance": 3.0,
    "negative_prompt": "worst quality, inconsistent motion, blurry, jittery, distorted",
    "offload": "model",
    "vae_tiling": true,
    "quantization": "none"
  },
  "memory": {
    "offload_options": [
      "none",
      "model",
      "sequential"
    ],
    "quantization_options": [
      "none",
      "int8",
      "nf4"
    ],
    "notes": "The text encoder is stored as 8-bit weights. Quantization here applies to the 2B transformer, which is only ~4 GB in bf16, so it defaults to off."
  }
}
