{
  "schema": 1,
  "id": "cogvideox",
  "name": "CogVideoX",
  "family": "THUDM",
  "version": "5B",
  "status": "ready",
  "kind": "video",
  "verified": false,
  "summary": "THUDM's 5B text-to-video model. Runs through the generic diffusers adapter; not yet tested by Reel.",
  "license": "CogVideoX License",
  "license_url": "https://huggingface.co/THUDM/CogVideoX-5b",
  "tasks": [
    "text-to-video"
  ],
  "adapter": "diffusers_auto",
  "download_gb": 21.5,
  "vram_gb": 9,
  "vram_note": "Estimate with NF4 transformer + model offload, not measured.",
  "python": {
    "torch_index": "https://download.pytorch.org/whl/cu128",
    "torch": [
      "torch>=2.7",
      "torchvision"
    ],
    "packages": [
      "diffusers>=0.33",
      "transformers>=4.49",
      "accelerate>=1.4",
      "sentencepiece",
      "protobuf",
      "safetensors",
      "huggingface_hub",
      "imageio",
      "imageio-ffmpeg",
      "numpy",
      "Pillow"
    ]
  },
  "weights": [
    {
      "repo_id": "THUDM/CogVideoX-5b",
      "dest": ".",
      "allow_patterns": [
        "model_index.json",
        "scheduler/*",
        "tokenizer/*",
        "text_encoder/*",
        "transformer/*",
        "vae/*"
      ]
    }
  ],
  "limits": {
    "max_width": 720,
    "max_height": 480,
    "size_multiple": 16,
    "frames": {
      "step": 8,
      "offset": 1,
      "min": 9,
      "max": 49,
      "default": 49
    },
    "fps": 8,
    "steps": {
      "min": 1,
      "max": 100
    },
    "presets": [
      {
        "w": 720,
        "h": 480
      }
    ]
  },
  "native": {
    "label": "720×480",
    "resolutions": [
      {
        "w": 720,
        "h": 480,
        "label": "720×480 (the only supported size)"
      }
    ],
    "frames": [
      49
    ],
    "fps": 8,
    "source": "https://huggingface.co/THUDM/CogVideoX-5b",
    "note": "The card: 720×480, \"no support for other resolutions\"; 6 seconds, 8 fps, 49 frames. Guidance 6, 50 steps."
  },
  "unlock": {
    "max_width": 720,
    "max_height": 480,
    "max_frames": 49,
    "known": true,
    "note": "CogVideoX-5b supports only its native size and length, so there is no extra headroom to unlock."
  },
  "defaults": {
    "width": 720,
    "height": 480,
    "steps": 50,
    "guidance": 6.0,
    "negative_prompt": "",
    "offload": "model",
    "vae_tiling": true,
    "quantization": "nf4"
  },
  "memory": {
    "offload_options": [
      "none",
      "model",
      "sequential"
    ],
    "quantization_options": [
      "none",
      "int8",
      "nf4"
    ],
    "notes": "",
    "estimate": {
      "weights_gb": {
        "transformer": 11.1,
        "text_encoder": 9.5,
        "vae": 0.9
      },
      "quantized": [
        "transformer",
        "text_encoder"
      ],
      "denoiser": "transformer",
      "tokens": {
        "spatial": 16,
        "temporal": 4
      },
      "hidden": 3072,
      "vae_mb_per_mpx_frame": 768,
      "vae_tile_mpx_frames": 1.5
    }
  },
  "adapter_config": {
    "pipeline": "CogVideoXPipeline",
    "variant": null
  }
}
