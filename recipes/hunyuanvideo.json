{
  "schema": 1,
  "id": "hunyuanvideo",
  "name": "HunyuanVideo",
  "family": "Tencent",
  "version": "13B",
  "status": "ready",
  "kind": "video",
  "verified": false,
  "summary": "Tencent's 13B text-to-video model. Large: NF4 quantization is required on a 16 GB card. Runs through the generic diffusers adapter; not yet tested by Reel.",
  "license": "Tencent Hunyuan Community License",
  "license_url": "https://huggingface.co/tencent/HunyuanVideo",
  "tasks": [
    "text-to-video"
  ],
  "adapter": "diffusers_auto",
  "download_gb": 41.9,
  "vram_gb": 14,
  "vram_note": "Estimate with NF4 transformer and text encoder + model offload, not measured. Tight on 16 GB.",
  "python": {
    "torch_index": "https://download.pytorch.org/whl/cu128",
    "torch": [
      "torch>=2.7",
      "torchvision"
    ],
    "packages": [
      "diffusers>=0.33",
      "transformers>=4.49",
      "accelerate>=1.4",
      "bitsandbytes>=0.46",
      "sentencepiece",
      "protobuf",
      "safetensors",
      "huggingface_hub",
      "imageio",
      "imageio-ffmpeg",
      "numpy",
      "Pillow"
    ]
  },
  "weights": [
    {
      "repo_id": "hunyuanvideo-community/HunyuanVideo",
      "dest": ".",
      "allow_patterns": [
        "model_index.json",
        "scheduler/*",
        "tokenizer*/*",
        "text_encoder*/*",
        "transformer/*",
        "vae/*"
      ]
    }
  ],
  "limits": {
    "max_width": 848,
    "max_height": 480,
    "size_multiple": 16,
    "frames": {
      "step": 4,
      "offset": 1,
      "min": 9,
      "max": 61,
      "default": 33
    },
    "fps": 15,
    "steps": {
      "min": 1,
      "max": 100
    },
    "presets": [
      {
        "w": 640,
        "h": 352
      },
      {
        "w": 848,
        "h": 480
      }
    ]
  },
  "defaults": {
    "width": 640,
    "height": 352,
    "steps": 30,
    "guidance": 6.0,
    "negative_prompt": "",
    "offload": "model",
    "vae_tiling": true,
    "quantization": "nf4"
  },
  "memory": {
    "offload_options": [
      "none",
      "model",
      "sequential"
    ],
    "quantization_options": [
      "none",
      "int8",
      "nf4"
    ],
    "notes": ""
  },
  "adapter_config": {
    "pipeline": "HunyuanVideoPipeline",
    "variant": null
  }
}
