      },
      {
        "w": 960,
        "h": 960,
        "label": "960×960 (720p, 1:1)"
      }
    ],
    "frames": [
      129
    ],
    "source": "https://huggingface.co/tencent/HunyuanVideo",
    "note": "Tencent's table lists 129 frames at every one of these sizes (they quote 45 GB at 544×960 and 60 GB at 720×1280 without offloading). Frames follow 4n+1. The official script saves 24 fps; Reel keeps the 15 fps of the diffusers example."
  },
  "unlock": {
    "max_width": 1280,
    "max_height": 1280,
    "max_frames": 129,
    "known": true,
    "note": "Native sizes go up to 1280×720 at 129 frames. Far beyond Reel's 16 GB limits: expect to need heavy offloading and a lot of system RAM."
  },
  "defaults": {
    "width": 640,
    "height": 352,
    "steps": 30,
    "guidance": 6.0,
    "negative_prompt": "",
