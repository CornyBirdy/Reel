      "numpy",
      "Pillow"
    ]
  },
  "weights": [
    {
      "repo_id": "Wan-AI/Wan2.2-TI2V-5B-Diffusers",
      "dest": ".",
      "allow_patterns": [
        "model_index.json",
        "scheduler/*",
        "tokenizer/*",
        "text_encoder/*",
        "transformer/*",
        "vae/*"
      ]
    }
  ],
  "limits": {
